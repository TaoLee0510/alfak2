+# Nodes and log weights for integrating a non-major state's initial log
+# abundance against its normal prior: the trapezoid rule on standard normal
+# nodes from -width to width.
+sparse_joint_quadrature_rule <- function(step = 0.2, width = 8) {
+  node <- seq(-width, width, by = step)
+  list(node = node, log_weight = stats::dnorm(node, log = TRUE) + log(step))
+}
