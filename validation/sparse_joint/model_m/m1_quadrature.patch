+#ifndef ALFAK2_SPARSE_JOINT_QUADRATURE_MODEL_H
+#define ALFAK2_SPARSE_JOINT_QUADRATURE_MODEL_H
+
+// The pair model of sparse_joint_model.h with the initial abundance of every
+// non-major state integrated out by quadrature rather than by the Laplace
+// approximation. Used when the data carry `minor_quadrature = 1`.
+//
+// A non-major state with few cells has two explanations of nearly equal
+// weight for a count in the second sample: it was there and not sampled, or
+// its neighbours made it during the interval. Its initial log abundance z then
+// has a posterior far from normal, and the Laplace approximation picks one
+// explanation, or finds none (a near-singular Hessian along z). Here
+//
+//   -log int N(z; m, s) Pois(y0; e^z)^w Pois(y1; lambda(z))^w dz,
+//   lambda(z) = exp(c1 + log(e^(z + a) + e^B)),
+//
+// with m, s the balance value and spread (or the free prior), a = d T the
+// state's own growth, B its log inflow and c1 the depth term, is computed on
+// fixed standard normal nodes u_k with log weights lw_k:
+//
+//   log sum_k exp(lw_k + w log Pois(y0; e^(m + s u_k)) + w log Pois(y1; lambda(m + s u_k))).
+//
+// A non-major state feeds its neighbours from its balance value (from the
+// prior mean without the balance prior), not from z: the inflow is first
+// order in the mutation rate, and a non-major source carries a few per cent
+// of a count at most. The initial log abundances of non-major states remain
+// in the parameter vector so that both models share it, and are mapped away.
+
+template<class Type>
+Type sparse_joint_model_quadrature(objective_function<Type>* obj) {
+  DATA_VECTOR(y0);
+  DATA_VECTOR(y1);
+  DATA_SCALAR(dt);
+  DATA_IVECTOR(edge_from);
+  DATA_IVECTOR(edge_to);
+  DATA_VECTOR(edge_log_prob);
+  DATA_VECTOR(log_self);
+  DATA_MATRIX(design);
+  DATA_IVECTOR(coef_group);
+  DATA_INTEGER(reference);
+  DATA_VECTOR(zeta_prior_mean);
+  DATA_VECTOR(zeta_prior_sd);
+  DATA_SCALAR(intercept_mean);
+  DATA_SCALAR(intercept_sd);
+  DATA_SCALAR(shell_sd);
+  DATA_VECTOR(log_scale_prior_mean);
+  DATA_VECTOR(log_scale_prior_sd);
+  DATA_INTEGER(n_major);
+  DATA_INTEGER(balance);
+  DATA_SCALAR(history);
+  DATA_SCALAR(balance_sd);
+  DATA_VECTOR(balance_offset);
+  DATA_VECTOR(weight);
+  DATA_VECTOR(quadrature_node);        // standard normal nodes
+  DATA_VECTOR(quadrature_log_weight);  // their log weights against N(0, 1)
+
+  PARAMETER_VECTOR(zeta);              // used for the majors only
+  PARAMETER_VECTOR(g);
+  PARAMETER_VECTOR(coef);
+  PARAMETER(theta1);
+  PARAMETER_VECTOR(log_scale);
+
+  int n = y0.size();
+  int K = quadrature_node.size();
+  Type nll = 0;
+
+  // Landscape prior, as in the pair model.
+  vector<Type> scale = exp(log_scale);
+  for (int k = 0; k < log_scale.size(); ++k)
+    nll -= dnorm(log_scale(k), log_scale_prior_mean(k), log_scale_prior_sd(k), true);
+  for (int k = 0; k < coef.size(); ++k) {
+    if (coef_group(k) == 0) nll -= dnorm(coef(k), intercept_mean, intercept_sd, true);
+    else if (coef_group(k) == 4) nll -= dnorm(coef(k), Type(0), shell_sd, true);
+    else nll -= dnorm(coef(k), Type(0), scale(coef_group(k) - 1), true);
+  }
+  vector<Type> trend = design * coef;
+  for (int i = 0; i < n; ++i) nll -= dnorm(g(i), trend(i), scale(3), true);
+
+  vector<Type> net(n);
+  for (int i = 0; i < n; ++i) net(i) = (Type(2) * exp(log_self(i)) - Type(1)) * exp(g(i));
+
+  // Balance values of non-major states fed by a major, as in the pair model.
+  vector<Type> log_start(n);
+  vector<int> fed(n);
+  fed.setZero();
+  if (balance == 1) {
+    for (int e = 0; e < edge_from.size(); ++e) {
+      int p = edge_from(e), j = edge_to(e);
+      if (p >= n_major || j < n_major) continue;
+      Type term = log(Type(2)) + edge_log_prob(e) + g(p) + zeta(p) - net(p) * history +
+        sparse_joint_log_phi1(net(j), net(p), history);
+      log_start(j) = fed(j) ? logspace_add(log_start(j), term) : term;
+      fed(j) = 1;
+    }
+  }
+
+  // Prior of each non-major state's initial log abundance, and what it feeds
+  // its neighbours from.
+  vector<Type> prior_mean(n), prior_sd(n), zeta_source(n);
+  for (int i = 0; i < n; ++i) {
+    if (i < n_major) {
+      prior_mean(i) = zeta_prior_mean(i);
+      prior_sd(i) = zeta_prior_sd(i);
+      zeta_source(i) = zeta(i);
+    } else if (balance == 1 && fed(i)) {
+      prior_mean(i) = log_start(i) + balance_offset(i);
+      prior_sd(i) = balance_sd;
+      zeta_source(i) = log_start(i);
+    } else {
+      prior_mean(i) = zeta_prior_mean(i);
+      prior_sd(i) = zeta_prior_sd(i);
+      zeta_source(i) = zeta_prior_mean(i);
+    }
+  }
+  for (int i = 0; i < n_major; ++i) nll -= dnorm(zeta(i), zeta_prior_mean(i), zeta_prior_sd(i), true);
+
+  // Inflow into each state over the interval.
+  vector<Type> log_inflow(n);
+  vector<int> has_inflow(n);
+  has_inflow.setZero();
+  for (int e = 0; e < edge_from.size(); ++e) {
+    int i = edge_from(e), j = edge_to(e);
+    Type term = log(Type(2)) + edge_log_prob(e) + g(i) + zeta_source(i) +
+      sparse_joint_log_phi1(net(j), net(i), dt);
+    log_inflow(j) = has_inflow(j) ? logspace_add(log_inflow(j), term) : term;
+    has_inflow(j) = 1;
+  }
+  Type c1 = theta1 - net(reference) * dt;
+
+  // Expected log counts: of the majors at their latent values, of the other
+  // states as posterior means E[e^z] and E[lambda(z)] (reported only).
+  vector<Type> log_expected0(n), log_intensity1(n), zeta_mean(n);
+  for (int i = 0; i < n_major; ++i) {
+    Type log_n1 = zeta(i) + net(i) * dt;
+    if (has_inflow(i)) log_n1 = logspace_add(log_n1, log_inflow(i));
+    log_expected0(i) = zeta(i);
+    log_intensity1(i) = c1 + log_n1;
+    zeta_mean(i) = zeta(i);
+    if (weight(i) == Type(0)) continue;
+    nll -= weight(i) * dpois(y0(i), exp(zeta(i)), true);
+    nll -= weight(i) * dpois(y1(i), exp(log_intensity1(i)), true);
+  }
+  vector<Type> z(K), log_l1(K), lk(K);
+  for (int i = n_major; i < n; ++i) {
+    Type a = net(i) * dt;
+    for (int k = 0; k < K; ++k) {
+      z(k) = prior_mean(i) + prior_sd(i) * quadrature_node(k);
+      log_l1(k) = has_inflow(i) ? c1 + logspace_add(z(k) + a, log_inflow(i)) : c1 + z(k) + a;
+      lk(k) = quadrature_log_weight(k);
+      if (weight(i) != Type(0)) {
+        lk(k) += weight(i) * (dpois(y0(i), exp(z(k)), true) + dpois(y1(i), exp(log_l1(k)), true));
+      }
+    }
+    Type log_marginal = lk(0);
+    for (int k = 1; k < K; ++k) log_marginal = logspace_add(log_marginal, lk(k));
+    nll -= log_marginal;
+    Type e0 = lk(0) + z(0), e1 = lk(0) + log_l1(0), mean_z = exp(lk(0) - log_marginal) * z(0);
+    for (int k = 1; k < K; ++k) {
+      e0 = logspace_add(e0, lk(k) + z(k));
+      e1 = logspace_add(e1, lk(k) + log_l1(k));
+      mean_z += exp(lk(k) - log_marginal) * z(k);
+    }
+    log_expected0(i) = e0 - log_marginal;
+    log_intensity1(i) = e1 - log_marginal;
+    zeta_mean(i) = mean_z;
+  }
+
+  REPORT(net);
+  REPORT(trend);
+  REPORT(log_expected0);
+  REPORT(log_intensity1);
+  REPORT(zeta_mean);
+  REPORT(prior_mean);
+  return nll;
+}
