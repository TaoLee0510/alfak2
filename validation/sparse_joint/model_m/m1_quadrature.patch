+# The posterior of a fit whose non-major initial abundances were integrated
+# out by quadrature (src/sparse_joint_quadrature_model.h). Its uncertainty is
+# the joint model's, by the same expected information, at the fitted latent
+# values with each non-major initial abundance at the log of its posterior
+# expected count; the expected counts are the quadrature model's posterior
+# expectations. The latent variables are therefore those of the joint model.
+sparse_joint_posterior_quadrature <- function(objective, tmb_data, map, random, mode, report, inner_control) {
+  joint_data <- tmb_data[setdiff(names(tmb_data), c("minor_quadrature", "quadrature_node", "quadrature_log_weight"))]
+  joint_map <- map[setdiff(names(map), "zeta")]
+  parameters <- objective$env$parList(par = mode)
+  minor <- seq_along(parameters$zeta) > tmb_data$n_major
+  parameters$zeta[minor] <- report$log_expected0[minor]
+  joint <- TMB::MakeADFun(joint_data, parameters, map = joint_map, random = random, DLL = "alfak2",
+                          silent = TRUE, inner.control = inner_control)
+  joint_mode <- joint$env$par
+  expected <- joint_data
+  expected$y0 <- exp(as.numeric(report$log_expected0))
+  expected$y1 <- exp(as.numeric(report$log_intensity1))
+  expected$balance_offset <- as.numeric(joint$report(joint_mode)$balance_residual)
+  information <- TMB::MakeADFun(expected, parameters, map = joint_map, random = random, DLL = "alfak2",
+                                silent = TRUE, inner.control = inner_control)$env$spHess(joint_mode, random = TRUE)
+  sparse_joint_posterior_solver(information, joint_mode, joint$env$random, cbind(expected$y0, expected$y1))
+}
